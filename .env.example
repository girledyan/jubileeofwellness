# Klaviyo public API key ("Company ID") — Settings > API Keys in Klaviyo.
# Safe to expose in the browser; it's the same value Klaviyo's own
# embedded forms use.
NEXT_PUBLIC_KLAVIYO_COMPANY_ID="XdaUeU"

# The list signups should be added to — open the list in Klaviyo and
# copy the ID from the URL (klaviyo.com/list/<LIST_ID>).
NEXT_PUBLIC_KLAVIYO_LIST_ID="Yvwp3U"
